[layer_names]

2d_render/layer_1="default"
2d_render/layer_2="player"
2d_render/layer_3="skylight"
2d_physics/layer_1="default"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="prop"
2d_physics/layer_5="ui"
2d_physics/layer_6="pickable"
2d_physics/layer_7="door"

[limbo_ai]

behavior_tree/behavior_tree_default_dir="res://ai_behavior/trees"
behavior_tree/user_task_dirs=PackedStringArray("res://scripts/ai_behavior/bt_tasks")

[physics]

2d/physics_engine="Rapier2D"
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

